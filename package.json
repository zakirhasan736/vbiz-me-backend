{
  "name": "vbizme-backend",
  "version": "1.0.0",
  "description": "VBizMe backend API",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "imports": {
    "@prisma/client": "./dist/generated/prisma/client.js",
    "@prisma/client/*": "./node_modules/@prisma/client/*"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc && tsx src/copy.assets.ts",
    "start": "tsx src/server.ts",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "migrate:laravel": "tsx --env-file=.env scripts/migrate-from-laravel.ts",
    "seed:packages": "tsx --env-file=.env scripts/seed-packages.ts",
    "migrate:media-urls": "tsx --env-file=.env scripts/backfill-legacy-media-urls.ts",
    "migrate:about-me": "tsx --env-file=.env scripts/backfill-about-me-from-posts.ts",
    "migrate:direct-tabs": "tsx --env-file=.env scripts/backfill-direct-tabs-from-posts.ts",
    "migrate:media": "tsx --env-file=.env scripts/migrate-media-to-s3.ts",
    "migrate:media:profile": "tsx --env-file=.env scripts/migrate-media-by-profile.ts",
    "sync:laravel-media": "tsx --env-file=.env scripts/sync-laravel-tab-media.ts",
    "s3:make-public": "tsx --env-file=.env scripts/make-s3-public.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/services/ai/__tests__/cardBuilder.test.ts",
    "test:turnstile": "tsx --test src/test/turnstile.test.ts",
    "test:api": "tsx --test src/test/api.contract.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --check",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^11.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "node-cron": "^4.6.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.3",
    "openai": "^4.104.0",
    "passkit-generator": "^3.5.7",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.3.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.65.0"
  },
  "license": "ISC"
}
