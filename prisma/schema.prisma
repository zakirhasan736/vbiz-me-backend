}

model SkillTag {
  id          String     @id @default(cuid())
  legacyId    Int?       @unique
  profileId   String
  profile     Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillTypeId String?
  skillType   SkillType? @relation(fields: [skillTypeId], references: [id], onDelete: SetNull)
  name        String
  level       String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([profileId])
}

/// Single About Me section per profile (title, rich description, featured media).
model AboutMe {
  id               String   @id @default(cuid())
  legacyPostId     Int?     @unique
  profileId        String   @unique
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title            String   @default("About Me")
  description      String?
  featuredMediaUrl String?
  status           String   @default("1")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([profileId])
}

/// Dedicated blog posts. Live table is "BlogDirect" (same columns as Faq).
model Blog {
  id               String    @id @default(cuid())
  profileId        String
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  legacyPostId     Int?      @unique
  legacyPostTypeId Int       @default(6)
  title            String?
  description      String?
  url              String?
  featuredImage    String?
  status           String    @default("1")
  sortOrder        Int       @default(0)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([profileId])
  @@map("BlogDirect")
}

/**
 * Direct-tab list/singleton items for tabs migrated off generic Post/postTypeId.
 * `tabKey` matches backend TAB_REGISTRY keys (e.g. faqs, video_links).
 * Singleton tabs enforce at most one active row per (profileId, tabKey) in service layer.
 */
model TabItem {
  id               String    @id @default(cuid())
  legacyPostId     Int?      @unique
  legacyPostTypeId Int?
  profileId        String
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tabKey           String
  title            String?
  description      String?
  url              String?
  featuredImage    String?
  status           String    @default("1")
  sortOrder        Int       @default(0)
  /**
   * Mapped post_metas and extra fields (category, date, issuer, year, …).
   */
  metas            Json?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([profileId])
  @@index([profileId, tabKey])
  @@index([tabKey])
  @@index([legacyPostId])
}

model Gallery {
  id               String    @id @default(cuid())
  legacyPostId     Int?      @unique
  legacyPostTypeId Int       @default(4)
  profileId        String
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String?
  description    String?
  url            String?
  featuredImage  String?
  /**
   * Deprecated: secondary portfolio attachments are no longer used.
   * Columns kept for legacy rows; writes always null them.
   */
  attachmentUrl  String?
  attachmentName String?
  status         String    @default("1")
  sortOrder      Int       @default(0)
  metas          Json?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([profileId])
  @@index([profileId, status])
}

