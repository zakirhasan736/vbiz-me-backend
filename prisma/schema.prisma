generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum UserRole {
  VCARD_OWNER     @map("vcard-owner")
  CORPORATE_OWNER @map("corporate-owner")
  ADMIN           @map("admin")
  SUPER_ADMIN     @map("super-admin")
}

enum AccountStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum PackageOwnerMode {
  SINGLE    @map("single")
  CORPORATE @map("corporate")
}

model User {
  id                String        @id @default(cuid())
  legacyId          Int?          @unique
  email             String        @unique
  password          String?
  name              String?
  avatar            String?
  role              UserRole      @default(VCARD_OWNER)
  provider          AuthProvider  @default(LOCAL)
  providerId        String?
  isVerified        Boolean       @default(false)
  isActive          Boolean       @default(true)
  accountStatus     AccountStatus @default(ACTIVE)
  companyName       String?
  staffRole         String?
  allowedModules    String[]      @default([])
  completedTours    String[]      @default([])
  otpCode           Int?
  otpCoolDown       DateTime?
  otpExpiresAt      DateTime?
  passwordChangedAt DateTime?
  stripeId          String?
  pmType            String?
  pmLastFour        String?
  trialEndsAt       DateTime?
  createdById       String?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  forgotPasswordTokens ForgotPasswordToken[]
  passwordSetupTokens  PasswordSetupToken[]
  authChallenges       AuthChallenge[]
  profiles             Profile[]             @relation("ProfileOwner")
  companyProfiles      Profile[]             @relation("ProfileCompany")
  createdProfiles      Profile[]             @relation("ProfileCreatedBy")
  companyEmployees     CompanyEmployee[]     @relation("EmployeeUser")
  ownedCompanies       CompanyEmployee[]     @relation("CompanyOwner")
  subscriptions        Subscription[]
  transactions         Transaction[]
  createdPosts         Post[]                @relation("PostCreatedBy")
  updatedPosts         Post[]                @relation("PostUpdatedBy")
  createdMeetings      Meeting[]             @relation("MeetingCreatedBy")
  createdCrmEvents     CrmEvent[]            @relation("CrmEventCreatedBy")
  assignedWorkNotes    WorkNote[]            @relation("WorkNoteAssignee")
  createdWorkNotes     WorkNote[]            @relation("WorkNoteCreatedBy")
  createdLeadNotes     LeadNote[]            @relation("LeadNoteCreatedBy")
  oneOnOneRequests     OneOnOneRequest[]     @relation("OneOnOneRequestCreator")
  oneOnOneMeetings     OneOnOneMeeting[]     @relation("OneOnOneMeetingCreator")
  oneOnOneCardOwners   OneOnOneRequest[]     @relation("OneOnOneCardOwner")
  oneOnOneMeetingOwners OneOnOneMeeting[]    @relation("OneOnOneMeetingOwner")
  auditLogs            AuditLog[]            @relation("AuditLogActor")
  supportTickets       SupportTicket[]       @relation("SupportTicketCreatedBy")
  announcements        Announcement[]        @relation("AnnouncementCreatedBy")
  teamNotices          TeamNotice[]          @relation("TeamNoticeOwner")
  canvaConnection      CanvaConnection?
  canvaOAuthPendings   CanvaOAuthPending[]
  aiGenerationLogs     AiGenerationLog[]
  aiCardSessions       AiCardSession[]
  featureOverrides     CorporateFeatureOverride[]

  @@index([provider, providerId])
}

model ForgotPasswordToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordSetupToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuthChallengePurpose {
  LOGIN
  ACTIVATE
}

model AuthChallenge {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      AuthChallengePurpose
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int                   @default(0)
  createdAt    DateTime              @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/**
 * Encrypted Canva OAuth tokens for a card owner (Connect API).
 */
model CanvaConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEnc  String
  refreshTokenEnc String
  tokenIv         String
  tokenTag        String
  expiresAt       DateTime
  scope           String?
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/**
 * Short-lived PKCE state for Canva OAuth (cleared after callback).
 */
model CanvaOAuthPending {
  state        String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeVerifier String
  returnTo     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Status {
  id        String   @id @default(cuid())
  legacyId  Int?     @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles Profile[]
}

