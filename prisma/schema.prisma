  /** not_started | in_progress | in_review | complete */
  status         String    @default("not_started")
  assigneeUserId String?
  assignee       User?     @relation("WorkNoteAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User      @relation("WorkNoteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  profileId      String?
  profile        Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  /** Zoho CRM lead id when linked */
  leadRef        String?
  startsAt       DateTime?
  dueAt          DateTime?
  remindAt       DateTime?
  reminderSentAt DateTime?
  ownerUserId    String?
  companyUserId  String?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([status, sortOrder])
  @@index([assigneeUserId])
  @@index([createdById])
  @@index([profileId])
  @@index([ownerUserId])
  @@index([companyUserId])
  @@index([dueAt])
  @@index([remindAt, reminderSentAt])
}

/**
 * Public 1-on-1 guest request. Parent of one_on_one_meetings.
 * Business request stays intact even when scheduling fails.
 * Statuses: open | awaiting_guest | scheduled | cancelled | completed
 */
model OneOnOneRequest {
  id               String   @id @default(cuid())
  profileId        String
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  guestName        String
  guestEmail       String
  guestPhone       String?
  message          String?
  status           String   @default("open")
  cardOwnerUserId  String?
  cardOwnerUser    User?    @relation("OneOnOneCardOwner", fields: [cardOwnerUserId], references: [id], onDelete: SetNull)
  corporateId      String? // company owner user id (nullable)
  createdByUserId  String?
  createdByUser    User?    @relation("OneOnOneRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  proposedTitle    String?
  proposedDescription String?
  proposedTimezone String?
  proposedDurationMinutes Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  meeting          OneOnOneMeeting?
  proposedSlots    OneOnOneProposedSlot[]

  @@index([profileId, status])
  @@index([guestEmail])
  @@index([status])
  @@index([cardOwnerUserId])
}

/**
 * Owner-proposed date/time options. Guest picks one; that creates the meeting.
 */
model OneOnOneProposedSlot {
  id               String   @id @default(cuid())
  requestId        String
  request          OneOnOneRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  date             String // YYYY-MM-DD
  startTime        String // HH:mm (24h)
  durationMinutes  Int      @default(30)
  timezone         String
  status           String   @default("available") // available | selected | discarded
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([requestId, status])
}

/**
 * Separate meeting entity linked to the original 1-on-1 request.
 * Statuses: scheduled | rescheduled | cancelled | completed
 */
model OneOnOneMeeting {
  id                   String   @id @default(cuid())
  requestId            String   @unique
  request              OneOnOneRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  cardId               String
  cardOwnerUserId      String
  cardOwnerUser        User     @relation("OneOnOneMeetingOwner", fields: [cardOwnerUserId], references: [id], onDelete: Restrict)
  corporateId          String?
  zohoCalendarEventId  String?
  zohoMeetingId        String?
  zohoMeetingUrl       String?
  title                String
  description          String?
  startAt              DateTime
  endAt                DateTime
  timezone             String
  status               String   @default("scheduled")
  createdByUserId      String
  createdByUser        User     @relation("OneOnOneMeetingCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  cancelledAt          DateTime?
  completedAt          DateTime?

  @@index([cardOwnerUserId, status])
  @@index([cardId])
  @@index([status])
  @@index([createdByUserId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  type      String
  actor     String?
  actorId   String?
  actorUser User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([profileId])
  @@index([actorId])
}

model SupportTicket {
  id          String   @id @default(cuid())
  channel     String
  type        String
  status      String   @default("open")
  subject     String
  details     String
  rating      Int?
  fromRole    String
  fromName    String
  fromEmail   String?
  adminReply  String?
  blocked     Boolean  @default(false)
  meta        Json?
  createdById String?
  createdBy   User?    @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([fromRole])
  @@index([channel])
  @@index([blocked])
}

model Announcement {
  id           String    @id @default(cuid())
  kind         String
  type         String
  title        String
  body         String
  status       String    @default("active")
  targetType   String    @default("all")
  targetEmails String[]  @default([])
  startsAt     DateTime?
  endsAt       DateTime?
  meta         Json?
  createdById  String?
  createdBy    User?     @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([kind])
}

/// Idempotency log for annual birthday wish emails / inbox notices.
model BirthdayWishLog {
  id        String   @id @default(cuid())
  profileId String
  year      Int
  sentAt    DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, year])
  @@index([year])
}

/// Corporate owner team announcements (directory banners / saver emails).
model TeamNotice {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation("TeamNoticeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  text            String
  type            String   @default("broadcast")
  audience        String   @default("all")
  targetProfileId String?
  recipientCount  Int?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([status, audience])
  @@index([targetProfileId])
}

/// Anonymous public-viewer dismiss / snooze state for global announcements and card notices.
model AnnouncementViewerState {
  id               String    @id @default(cuid())
  announcementType String
  announcementId   String
  profileId        String?
  visitorId        String?
  browserKey       String
  dismissedAt      DateTime?
  suppressUntil    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([announcementType, announcementId, browserKey])
  @@index([announcementType, announcementId])
  @@index([profileId, visitorId])
  @@index([browserKey])
}

/// Catalog metadata for fixed vCard shells (v1 / v2 / v3). Shell UI lives in the frontend.
model CardTemplate {
  id          String   @id
  name        String
  description String
  status      String   @default("active")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, sortOrder])
}

/** Curated homepage "Explore live demos" list. Admin CRUD can edit later; seed provides defaults. */
model LandingDemoCard {
  id                   String   @id @default(cuid())
  category             String
  slug                 String   @unique
  /** Curated list subtitle (e.g. CEO/Founder). Falls back to Profile.designation when null. */
  designationOverride  String?
  profileId            String?
  profile              Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  sortOrder            Int      @default(0)
  status               String   @default("active")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([profileId])
}

model PushSubscription {
  id           String    @id @default(cuid())
  legacyId     Int?      @unique
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  endpoint     String
  endpointHash String
  p256dh       String
  auth         String
  browser      String?
  platform     String?
  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  preferences PushNotificationPreference?

  @@unique([profileId, endpointHash])
  @@index([profileId])
  @@index([endpointHash])
}

model PushNotificationPreference {
  id                  String           @id @default(cuid())
  legacyId            Int?             @unique
  pushSubscriptionId  String           @unique
  pushSubscription    PushSubscription @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)
  serviceUpdates      Boolean          @default(true)
  portfolioUpdates    Boolean          @default(true)
  contactUpdates      Boolean          @default(true)
  offers              Boolean          @default(true)
  businessHours       Boolean          @default(true)
  news                Boolean          @default(true)
  eventUpdates        Boolean          @default(true)
  announcementUpdates Boolean          @default(true)
  themeUpdates        Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Package {
  id              String           @id @default(cuid())
  legacyId        Int?             @unique
  name            String
  slug            String?          @unique
  description     String?
  monthlyPrice    Int              @default(0)
  yearlyPrice     Int              @default(0)
  signupFeeCents  Int              @default(0)
  stripePriceId   String?
  stripeSignupPriceId String?
  ownerMode       PackageOwnerMode @default(SINGLE)
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  features        PackageFeature[]
  subscriptions   Subscription[]
}

model PackageFeature {
  id           String   @id @default(cuid())
  legacyId     Int?     @unique
  packageId    String
  package      Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  featureKey   String
  featureValue String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([packageId, featureKey])
  @@index([packageId])
}

model CorporateFeatureOverride {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureKey   String
  featureValue String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, featureKey])
  @@index([userId])
}

model Subscription {
  id                       String    @id @default(cuid())
  legacyId                 Int?      @unique
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId                String?
  package                  Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  name                     String?
  stripeId                 String?
  stripeStatus             String?
  stripePrice              String?
  quantity                 Int?
  trialEndsAt              DateTime?
  endsAt                   DateTime?
  provider                 String?
  negotiatedMonthlyCents   Int?
  negotiatedSignupFeeCents Int?
  signupFeeChargedAt       DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  items        SubscriptionItem[]
  transactions Transaction[]

  @@index([userId])
  @@index([packageId])
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  legacyId       Int?         @unique
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripeId       String?
  stripeProduct  String?
  stripePrice    String?
  quantity       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([subscriptionId])
}

model Transaction {
  id             String        @id @default(cuid())
  legacyId       Int?          @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Int           @default(0)
  currency       String        @default("usd")
  status         String?
  provider       String?
  meta           Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([subscriptionId])
}

model StripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  createdAt   DateTime @default(now())
}

model CompanyEmployee {
  id        String   @id @default(cuid())
  legacyId  Int?     @unique
  userId    String
  user      User     @relation("EmployeeUser", fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   User     @relation("CompanyOwner", fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

/**
 * AI card-agent usage for cost and routing analytics.
 */
model AiGenerationLog {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profileId         String?
  profile           Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  sessionId         String?
  jobId             String?
  stage             String?
  task              String
  model             String
  tier              String
  inputTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  outputTokens      Int      @default(0)
  estimatedCost     Float    @default(0)
  latencyMs         Int      @default(0)
  retryNumber       Int      @default(0)
  success           Boolean  @default(true)
  escalatedFrom     String?
  error             String?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([profileId])
  @@index([sessionId])
  @@index([jobId])
  @@index([tier])
  @@index([createdAt])
}

/**
 * One Auto AI card-build job per user run (extract → SOL → fields → apply).
 */
model AiCardSession {
  id                  String   @id @default(cuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profileId           String?
  websiteUrl          String?
  sourceHash          String?
  status              String   @default("QUEUED")
  rawSources          Json?
  normalizedSources   Json?
  businessProfile     Json?
  generatedContent    Json?
  finalBlueprint      Json?
  architecture        Json?
  selectedNavIds      Json?
  fieldGraph          Json?
  fieldDecisions      Json?
  assembledDraft      Json?
  userProgress        Json?
  errorMessage        String?
  architectureVersion Int      @default(1)
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([profileId])
  @@index([status])
  @@index([sourceHash])
  @@index([expiresAt])
}
