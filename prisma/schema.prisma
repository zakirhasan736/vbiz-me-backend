  /** text | voice | voice_to_text */
  kind            String
  content         String?
  audioUrl        String?
  audioFileName   String?
  audioMimeType   String?
  startsAt        DateTime?
  dueAt           DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([guestUserDataId, createdAt])
  @@index([createdById])
}

