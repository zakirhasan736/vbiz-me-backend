model Country {
  id        String   @id @default(cuid())
  legacyId  Int?     @unique
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states State[]
  cities City[]
}

model State {
  id        String   @id @default(cuid())
  legacyId  Int?     @unique
  name      String
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities City[]

  @@index([countryId])
}

model City {
  id        String   @id @default(cuid())
  legacyId  Int?     @unique
  name      String
  stateId   String?
  state     State?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stateId])
  @@index([countryId])
}

model Profile {
  id              String         @id @default(cuid())
  legacyId        Int?           @unique
  creationKey     String?        @unique
  userId          String?
  user            User?          @relation("ProfileOwner", fields: [userId], references: [id], onDelete: SetNull)
  companyUserId   String?
  companyUser     User?          @relation("ProfileCompany", fields: [companyUserId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?          @relation("ProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  statusId        String?
  status          Status?        @relation(fields: [statusId], references: [id], onDelete: SetNull)
  genderId        String?
  gender          Gender?        @relation(fields: [genderId], references: [id], onDelete: SetNull)
  maritalStatusId String?
  maritalStatus   MaritalStatus? @relation(fields: [maritalStatusId], references: [id], onDelete: SetNull)
  professionId    String?
  profession      Profession?    @relation(fields: [professionId], references: [id], onDelete: SetNull)

  name                String
  slug                String?   @unique
  prof                String?
  companyName         String?
  email               String
  website             String?
  lastName            String?
  dob                 DateTime?
  phone               String?
  whatsapp            String?
  countryCode         String?
  facebook            String?
  instagram           String?
  twitter             String?
  tiktok              String?
  youtube             String?
  rumble              String?
  truth               String?
  linkedin            String?
  pinterest           String?
  avatar              String?
  colorCode           String    @default("#212121")
  address             String?
  city                String?
  state               String?
  zipCode             String?
  about               String?
  isEmploy            Boolean   @default(false)
  designation         String?
  referralCount       Int       @default(0)
  referralCode        String?   @unique
  isPublic            Boolean   @default(true)
  /**
   * Incomplete / not yet published cards show under Draft tabs in the dashboard.
   */
  isDraft             Boolean   @default(false)
  /**
   * Snapshot of status/isPublic/isDraft before account pause/suspend cascade; cleared on restore.
   */
  accountLockSnapshot Json?
  viewCount           Int       @default(0)
  template            String    @default("default")
  themeConfig         Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  addresses           Address[]
  education           Education[]
  experiences         Experience[]
  services            Service[]
  portfolios          Portfolio[]
  reviews             Review[]
  posts               Post[]
  aboutMe             AboutMe?
  blogs               Blog[]
  tabItems            TabItem[]
  galleries           Gallery[]
  videos              Video[]
  bbbAccreditations   BbbAccreditation[]
  licensing           Licensing[]
  dcp                 Dcp[]
  certificateLicenses CertificateLicense[]
  faqs                Faq[]
  calendarSections    CalendarSection[]
  propertyListings    PropertyListing[]
  profileEvents       ProfileEvent[]
  mediaPress          MediaPress[]
  missionStatements   MissionStatement[]
  menuSections        MenuSection[]
  whyChooseUs         WhyChooseUs?
  directAnnouncements AnnouncementDirect[]
  joinMyTeam          JoinMyTeam[]
  bookings            Booking[]
  additionalServices  AdditionalService[]
  videoLinks          VideoLink[]
  inventory           Inventory[]
  homeSolar           HomeSolar[]
  resiliencyProducts  ResiliencyProduct[]
  breakfast           Breakfast[]
  lunch               Lunch[]
  dinner              Dinner[]
  products            Product[]
  salesPeople         SalesPerson[]
  teamMembers         TeamMember[]
  clients             Client[]
  generalPosts        GeneralPost[]
  insuranceLicenses   InsuranceLicense[]
  videoExplainers     VideoExplainer[]
  customTabs          CustomTab[]
  customTabItems      CustomTabItem[]
  settings            Setting[]
  profileSettings     ProfileSetting?
  socialLinks         SocialLink[]
  skillTags           SkillTag[]
  contacts            Contact[]
  guestUsers          GuestUserData[]
  userNotes           UserNote[]
  eventLogs           EventLog[]
  pushSubscriptions   PushSubscription[]
  menus               Menu[]
  attachments         Attachment[]
  meetings            Meeting[]
  crmEvents           CrmEvent[]
  workNotes           WorkNote[]
  oneOnOneRequests    OneOnOneRequest[]
  auditLogs           AuditLog[]
  birthdayWishLogs    BirthdayWishLog[]
  aiGenerationLogs    AiGenerationLog[]
  assistantConfig     ProfileAssistantConfig?
  assistantKnowledge  ProfileAssistantKnowledge[]
  landingDemoCards    LandingDemoCard[]

  @@index([userId])
  @@index([companyUserId])
  @@index([slug])
  @@index([email])
  @@index([isPublic])
  @@index([isDraft])
}

