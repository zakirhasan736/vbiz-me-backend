  status          String    @default("Scheduled")
  /** global | group | one_to_one */
  scope           String    @default("one_to_one")
  profileId       String?
  profile         Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  /** Profile ids included in a group event (JSON string array). */
  groupProfileIds Json?
  /** [{ url, fileName, mimeType?, publicId?, resourceType? }] image|video|audio */
  attachments     Json?
  /** Selected card or saved-guest recipient for cron mail delivery. */
  recipientEmail  String?
  recipientName   String?
  createdById     String?
  createdBy       User?     @relation("CrmEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  googleEventId   String?
  meetLink        String?
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([startsAt])
  @@index([profileId])
  @@index([type])
  @@index([scope])
  @@index([reminderSentAt, startsAt])
}

