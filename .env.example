NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
BASE_SITE=http://localhost:3000

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vbizme?schema=public

ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Fonts Developer API (Web Fonts) — server-side only for GET /fonts
GOOGLE_FONTS_API_KEY=
# Shared admin Google Calendar (meetings + Google Meet).
# Use a SEPARATE OAuth client from login (different redirect URI is fine).
# 1) Set GOOGLE_CALENDAR_CLIENT_ID / GOOGLE_CALENDAR_CLIENT_SECRET for that client.
# 2) Generate a refresh token with that same client and scopes:
#    https://www.googleapis.com/auth/calendar
#    https://www.googleapis.com/auth/calendar.events
# 3) Paste it as GOOGLE_CALENDAR_REFRESH_TOKEN.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=UTC
# Redirect URI for the calendar OAuth client (must match the URI used to mint the refresh token)
GOOGLE_CALENDAR_REDIRECT_URI=

# Zoho Calendar + Zoho Meeting (preferred for admin Schedules).
# Server-side ONLY — never put these in the admin/frontend .env.
# 1) Create a Zoho API Console self-client / server-based app.
# 2) Generate a refresh token with scopes:
#      ZohoCalendar.event.ALL
#      ZohoMeeting.meeting.ALL
# 3) Find CALENDAR_UID via GET https://calendar.zoho.com/api/v1/calendars
#    Header: Authorization: Zoho-oauthtoken <access_token>
# Region tip: US=accounts.zoho.com / EU=accounts.zoho.eu / IN=accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CALENDAR_UID=
ZOHO_CALENDAR_TIMEZONE=Asia/Dhaka
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_API_DOMAIN=calendar.zoho.com
# auto = Zoho if configured, else Google | zoho | google
CALENDAR_PROVIDER=zoho

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Stripe Checkout + webhooks (server-side only). Failed payments do not activate paid access.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API with credentials.
# Production example: include the landing site, not only the app.
# https://app.vbizme.com,https://www.vbizme.com,https://vbizme.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,https://app.nextcreavo.com,https://app.vbizme.com,https://www.vbizme.com,https://vbizme.com

MAIL_ADDRESS=
MAIL_PASS=
RESEND_MAIL_MINUTES=2
OTP_EXPIRE_MINUTES=10
# Card-owner login requires email OTP after password. Staff stay password-only.
# Rollback (no code deploy): LOGIN_OTP_REQUIRED=false and restart the API.
LOGIN_OTP_REQUIRED=true
# Public self-serve register + new social sign-ups. Keep false until product re-opens signup.
# Rollback: PUBLIC_SIGNUP_ENABLED=true and restart the API (register route stays in code).
PUBLIC_SIGNUP_ENABLED=false
FORGOT_PASSWORD_EXPIRY_MINUTES=15
PASSWORD_SETUP_EXPIRY_MINUTES=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Prefer S3_BUCKET; AWS_BUCKET is accepted as a fallback
S3_BUCKET=
AWS_BUCKET=
S3_KEY_PREFIX=vbizme
# Public CDN or bucket URL used to build object URLs (no trailing slash)
S3_PUBLIC_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com

# Web Push (VAPID). Public key must match frontend NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@vbizme.com

# AI Card Creation Agent — server-side ONLY (never put these in the admin/frontend .env)
# Required: OPENAI_API_KEY. Restart the API after changing any of these.
OPENAI_API_KEY=
OPENAI_CARD_MODEL=gpt-5.6-luna
# Realtime talking assistant (vCard Live Agent + landing-page Live Agent). Backend only.
# Browser never gets this key. It calls:
#   POST /api/v1/public/profiles/:id/assistant/live-token
#   POST /api/v1/public/landing/assistant/live-token
# and the backend mints a short-lived Gemini Live token.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
OPENAI_TAB_FILL_MODEL=gpt-4o
# Per-tier models: SOL=gpt-5.6-sol, Terra=gpt-5.6-terra, Luna=gpt-5.6-luna, Vision=gpt-4o
# If a named model is unavailable, the API retries gpt-4.1 / gpt-4o / gpt-4o-mini without showing model names in the UI.
# Tab auto-fill: OCR uses GPT-4o then Terra fallback; JSON fill uses GPT-4o
OPENAI_CARD_MODEL_LUNA=gpt-5.6-luna
OPENAI_CARD_MODEL_TERRA=gpt-5.6-terra
OPENAI_CARD_MODEL_SOL=gpt-5.6-sol
OPENAI_CARD_MODEL_VISION=gpt-4o
# Optional USD per 1M tokens for usage logs
AI_COST_LUNA_INPUT_PER_M=0.15
AI_COST_LUNA_OUTPUT_PER_M=0.6
AI_COST_TERRA_INPUT_PER_M=2
AI_COST_TERRA_OUTPUT_PER_M=8
AI_COST_SOL_INPUT_PER_M=2
AI_COST_SOL_OUTPUT_PER_M=8
AI_COST_VISION_INPUT_PER_M=2.5
AI_COST_VISION_OUTPUT_PER_M=10

PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120

# New cards must supply email, phone, and date of birth. Email and phone are
# checked against other cards only at create time. Editing an existing card
# does not re-check uniqueness, so older cards are left as-is.

# Cloudflare Turnstile protection for login, registration, and forgot-password.
# Keep the secret key server-side. Set TURNSTILE_ENABLED=true after configuring
# NEXT_PUBLIC_TURNSTILE_SITE_KEY in the admin app.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
# Optional hostname returned by Cloudflare, for example app.vbizme.com.
TURNSTILE_EXPECTED_HOSTNAME=

# Preferred: set LARAVEL_MYSQL_URL after loading a dump, OR point at live Laravel MySQL.
# Special chars in the password MUST be URL-encoded (! → %21, $ → %24).
# Example: mysql://dbadmin:Eng%21neer%24786@13.53.83.153:3306/vbizme_app
LARAVEL_MYSQL_URL=
# Base URL of the old Laravel public host (used to rebuild /storage/ecard/... paths for S3 migration)
MEDIA_BASE_URL=https://app.vbizme.com

# Canva Connect — server-side ONLY (admin/frontend must NOT hold these secrets)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must match Canva Developer Portal Authentication redirect URL exactly
CANVA_REDIRECT_URI=http://localhost:5000/api/v1/integrations/canva/callback
# Long random secret to encrypt stored Canva tokens (32+ chars)
CANVA_TOKEN_ENCRYPTION_KEY=
# Optional; defaults include design export scopes
# CANVA_SCOPES=asset:read asset:write design:meta:read design:content:read design:content:write folder:read folder:write profile:read

# Google Wallet Generic passes — server-side ONLY (never put these in admin/frontend .env)
# Issuer ID from Google Pay & Wallet Console. Demo mode: only test Gmails can add until published.
GOOGLE_WALLET_ISSUER_ID=
# Option A: paste the full service-account JSON as one line
GOOGLE_WALLET_SA_JSON=
# Option B: email + PEM (keep \n escapes inside quotes)
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Optional class suffix + HTTPS logo fallback
GOOGLE_WALLET_CLASS_SUFFIX=vbiz-digital-card
GOOGLE_WALLET_LOGO_URL=

# Apple Wallet .pkpass — server-side ONLY (never put these in admin/frontend .env)
# 1) Apple Developer (paid) → Certificates, IDs & Profiles → Identifiers → Pass Type IDs
#    Create e.g. pass.com.vbizme.card
# 2) Create a Pass Type ID certificate and export it as .p12 from Keychain (or OpenSSL)
# 3) Set TEAM_ID (Membership → Team ID) + PASS_TYPE_ID
# Option A: PEM
APPLE_WALLET_PASS_TYPE_ID=pass.com.vbizme.card
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_ORGANIZATION=vBiz
APPLE_WALLET_SIGNER_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
APPLE_WALLET_SIGNER_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
# Option B: Keychain .p12 as base64 (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes('pass.p12')))
APPLE_WALLET_P12_BASE64=
APPLE_WALLET_P12_PASSPHRASE=
# Optional WWDR override (Apple WWDR G4 is bundled)
APPLE_WALLET_WWDR_CERT=

# Daily birthday wishes (owner email + owner inbox notice). Set ENABLED=false to disable.
BIRTHDAY_CRON_ENABLED=true
BIRTHDAY_CRON_TZ=Asia/Dhaka
BIRTHDAY_CRON_EXPR=0 9 * * *
