NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
BASE_SITE=http://localhost:3000

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vbizme?schema=public

ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Fonts Developer API (Web Fonts) — server-side only for GET /fonts
GOOGLE_FONTS_API_KEY=
# Shared admin Google Calendar (meetings + Google Meet).
# 1) Use ONE GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET pair (no duplicates in .env).
# 2) Generate a refresh token with scopes:
#    https://www.googleapis.com/auth/calendar
#    https://www.googleapis.com/auth/calendar.events
# 3) Paste it as GOOGLE_CALENDAR_REFRESH_TOKEN.
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=UTC
# Optional redirect URI used when generating the refresh token offline
# GOOGLE_REDIRECT_URI=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API with credentials.
# Production example: https://app.nextcreavo.com,https://app.vbizme.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000

MAIL_ADDRESS=
MAIL_PASS=
RESEND_MAIL_MINUTES=2
OTP_EXPIRE_MINUTES=2
FORGOT_PASSWORD_EXPIRY_MINUTES=15
PASSWORD_SETUP_EXPIRY_MINUTES=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Prefer S3_BUCKET; AWS_BUCKET is accepted as a fallback
S3_BUCKET=
AWS_BUCKET=
S3_KEY_PREFIX=vbizme
# Public CDN or bucket URL used to build object URLs (no trailing slash)
S3_PUBLIC_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com

# Web Push (VAPID). Public key must match frontend NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@vbizme.com

# AI Card Creation Agent — server-side ONLY (never put these in the admin/frontend .env)
OPENAI_API_KEY=
OPENAI_CARD_MODEL=gpt-4o-mini

PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120

# Preferred: set LARAVEL_MYSQL_URL after loading a dump, OR point at live Laravel MySQL.
# Special chars in the password MUST be URL-encoded (! → %21, $ → %24).
# Example: mysql://dbadmin:Eng%21neer%24786@13.53.83.153:3306/vbizme_app
LARAVEL_MYSQL_URL=
# Base URL of the old Laravel public host (used to rebuild /storage/ecard/... paths for S3 migration)
MEDIA_BASE_URL=https://app.vbizme.com

# Canva Connect — server-side ONLY (admin/frontend must NOT hold these secrets)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must match Canva Developer Portal Authentication redirect URL exactly
CANVA_REDIRECT_URI=http://localhost:5000/api/v1/integrations/canva/callback
# Long random secret to encrypt stored Canva tokens (32+ chars)
CANVA_TOKEN_ENCRYPTION_KEY=
# Optional; defaults include design export scopes
# CANVA_SCOPES=asset:read asset:write design:meta:read design:content:read design:content:write folder:read folder:write profile:read
