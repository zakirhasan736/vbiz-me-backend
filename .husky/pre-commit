# Prefer Yarn 4 via Corepack when global `yarn` is still classic v1.
yarn_cmd() {
  if command -v corepack >/dev/null 2>&1; then
    corepack yarn "$@"
  else
    yarn "$@"
  fi
}

echo ""
echo "🔍 Running pre-commit checks..."
echo ""

# ─── [1/3] Prettier (formatting) ───────────────────────────────────

echo "▶ [1/3] Checking code formatting (Prettier)"
yarn_cmd format:check || {
echo ""
echo "❌ Prettier check failed 💀💀 your code formatting sucks"
echo "💡 Run 'corepack yarn format' (or 'npx prettier --write .'), then 'git add' and commit again."
echo ""
exit 1
}

# ─── [2/3] ESLint (lint rules) ─────────────────────────────────────

echo ""
echo "▶ [2/3] Checking lint rules (ESLint)"
yarn_cmd lint || {
echo ""
echo "❌ ESLint failed 💀💀 your code has lint errors"
echo "💡 Fix the rule violations shown above. Re-check with 'corepack yarn lint'."
echo ""
exit 1
}

# ─── [3/3] TypeScript (type check) ─────────────────────────────────

echo ""
echo "▶ [3/3] Checking types (TypeScript)"
yarn_cmd typecheck || {
echo ""
echo "❌ TypeScript check failed 💀💀 your types are broken"
echo "💡 Fix the type errors shown above. Re-check with 'corepack yarn typecheck'."
echo ""
exit 1
}

echo ""
echo "✅ All checks passed — committing."
echo ""
