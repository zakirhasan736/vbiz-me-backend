# Prefer package scripts via Yarn when the lockfile matches; fall back to npm
# (Yarn 4 + classic yarn.lock v1 fails with "not present in your lockfile").
run_pkg() {
  if command -v corepack >/dev/null 2>&1; then
    if corepack yarn "$@" 2>/dev/null; then
      return 0
    fi
  elif command -v yarn >/dev/null 2>&1; then
    if yarn "$@" 2>/dev/null; then
      return 0
    fi
  fi
  npm run "$@"
}

echo ""
echo "🔍 Running pre-commit checks..."
echo ""

# ─── [1/3] Prettier (formatting) ───────────────────────────────────

echo "▶ [1/3] Checking code formatting (Prettier)"
run_pkg format:check || {
echo ""
echo "❌ Prettier check failed 💀💀 your code formatting sucks"
echo "💡 Run 'npm run format' (or 'npx prettier --write .'), then 'git add' and commit again."
echo ""
exit 1
}

# ─── [2/3] ESLint (lint rules) ─────────────────────────────────────

echo ""
echo "▶ [2/3] Checking lint rules (ESLint)"
run_pkg lint || {
echo ""
echo "❌ ESLint failed 💀💀 your code has lint errors"
echo "💡 Fix the rule violations shown above. Re-check with 'npm run lint'."
echo ""
exit 1
}

# ─── [3/3] TypeScript (type check) ─────────────────────────────────

echo ""
echo "▶ [3/3] Checking types (TypeScript)"
run_pkg typecheck || {
echo ""
echo "❌ TypeScript check failed 💀💀 your types are broken"
echo "💡 Fix the type errors shown above. Re-check with 'npm run typecheck'."
echo ""
exit 1
}

echo ""
echo "✅ All checks passed — committing."
echo ""
